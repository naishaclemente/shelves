<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.shelves</groupId>
    <artifactId>shelves</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Shelves</name>
    <description>A straightforward inventory tool for personal and professional use.</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <javafx.version>21.0.2</javafx.version>
        <sqlite.version>3.45.1.0</sqlite.version>
        <slf4j.version>2.0.12</slf4j.version>
    </properties>

    <dependencies>

        <!--
            JavaFX is no longer part of the JDK, so it has to be declared like
            any other library. Controls pulls in graphics and base with it.
        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- The database. One file, no server, nothing for a marker to set up. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!--
            Not optional, despite appearances. From version 3.42 onwards
            sqlite-jdbc has a hard dependency on the slf4j API, and without it
            the driver class fails to load with a NoClassDefFoundError that
            looks nothing like the actual problem.

            slf4j-nop is the no-op binding: it satisfies the dependency and
            silences the "no providers were found" warning on startup without
            adding a logging framework the project does not need.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!--
                Runs the application with "mvn javafx:run". This is the normal
                way to start it during development, because the plugin puts the
                JavaFX modules on the module path for you.
            -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.shelves.App</mainClass>
                </configuration>
            </plugin>

            <!--
                Builds a single runnable jar with "mvn package".

                The main class is Launcher rather than App on purpose. JavaFX
                refuses to start when the main class extends Application and the
                runtime is on the classpath instead of the module path, which is
                exactly the situation inside a shaded jar. Launching from a class
                that does not extend Application sidesteps that check.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.shelves.Launcher</mainClass>
                                </transformer>
                                <!-- Keeps the JDBC driver registration intact. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Runs the checks in SmokeTest with "mvn verify".

                These are written as a plain main method rather than as JUnit
                tests, so the project builds and checks itself with no test
                framework to install. Swapping them to JUnit later is mechanical.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>run-checks</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.shelves.SmokeTest</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Puts SmokeTest on the main source path so it compiles with the app. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>add-checks-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/test/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
